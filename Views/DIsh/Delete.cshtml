@model QuanLyMonAn.Models.Dish_BIT240154

@{
    ViewData["Title"] = "Delete Dish";
}

<div class="container py-4">
    <div class="card shadow-sm mx-auto" style="max-width: 650px;">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Confirm Delete</h4>
        </div>

        <div class="card-body">
            <div class="alert alert-warning">
                Are you sure you want to delete this dish?
            </div>

            <dl class="row">
                <dt class="col-sm-4">Dish Name</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Category</dt>
                <dd class="col-sm-8">
                    @(Model.DishCategory?.Name ?? "N/A")
                </dd>

                <dt class="col-sm-4">Price</dt>
                <dd class="col-sm-8">@Model.Price.ToString("N0") VND</dd>

                <dt class="col-sm-4">Preparation Time</dt>
                <dd class="col-sm-8">@Model.PreparationTime minutes</dd>
            </dl>

            <form asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post">
                <button type="submit" class="btn btn-danger">
                    Yes, Delete
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>
