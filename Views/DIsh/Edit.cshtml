@model QuanLyMonAn.Models.Dish_BIT240154

@{
    ViewData["Title"] = "Edit Dish";
}

<div class="container py-4">
    <div class="card shadow-sm mx-auto" style="max-width: 750px;">
        <div class="card-header bg-warning">
            <h4 class="mb-0">Edit Dish</h4>
        </div>

        <div class="card-body">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Dish Name</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DishCategoryId" class="form-label">Category</label>
                    <select asp-for="DishCategoryId"
                            asp-items="ViewBag.Categories"
                            class="form-select">
                        <option value="">-- Select category --</option>
                    </select>
                    <span asp-validation-for="DishCategoryId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="form-label">Price (VND)</label>
                    <input asp-for="Price" type="number"
                           min="0.01" step="0.01" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PreparationTime" class="form-label">
                        Preparation Time (minutes)
                    </label>
                    <input asp-for="PreparationTime" type="number"
                           min="1" class="form-control" />
                    <span asp-validation-for="PreparationTime"
                          class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="IsAvailable" class="form-check-input" />
                    <label asp-for="IsAvailable" class="form-check-label">
                        Available for sale
                    </label>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">
                        Description
                    </label>
                    <textarea asp-for="Description"
                              class="form-control" rows="4"></textarea>
                </div>

                <button type="submit" class="btn btn-warning">
                    Save Changes
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
