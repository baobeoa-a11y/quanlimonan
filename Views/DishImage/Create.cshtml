@{
    ViewData["Title"] = "Add Dish Image";
    int dishId = ViewBag.DishId;
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Add Dish Image</h3>
        </div>

        <div class="card-body">
            <p>Dish ID: <strong>@dishId</strong></p>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="dishId" value="@dishId" />

                <div class="mb-3">
                    <label for="imageUrl" class="form-label">
                        Image URL
                    </label>

                    <input type="url"
                           id="imageUrl"
                           name="imageUrl"
                           class="form-control"
                           placeholder="https://example.com/image.jpg"
                           required />

                    <span class="text-danger">
                        @Html.ValidationMessage("imageUrl")
                    </span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Image preview</label>
                    <div>
                        <img id="imagePreview"
                             src="https://placehold.co/400x250?text=Image+Preview"
                             alt="Image preview"
                             style="max-width:400px; max-height:250px; object-fit:contain;"
                             class="img-thumbnail" />
                    </div>
                </div>

                <div class="form-check mb-4">
                    <input type="checkbox"
                           id="isThumbnail"
                           name="isThumbnail"
                           value="true"
                           class="form-check-input" />

                    <label for="isThumbnail" class="form-check-label">
                        Set as thumbnail / Đặt làm ảnh đại diện
                    </label>
                </div>

                <button type="submit" class="btn btn-success">
                    Save Image
                </button>

                <a asp-action="Index"
                   asp-route-dishId="@dishId"
                   class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const imageUrlInput = document.getElementById("imageUrl");
        const imagePreview = document.getElementById("imagePreview");

        imageUrlInput.addEventListener("input", function() {
            const url = imageUrlInput.value.trim();

            if (url) {
                imagePreview.src = url;
            } else {
                imagePreview.src =
                    "https://placehold.co/400x250?text=Image+Preview";
            }
        });

        imagePreview.addEventListener("error", function() {
            imagePreview.src =
                "https://placehold.co/400x250?text=Image+not+available";
        });
    </script>
}
