@model IEnumerable<QuanLyMonAn.Models.DishImage_BIT240154>

@{
    ViewData["Title"] = "Dish Images";
    int dishId = ViewBag.DishId;
    string dishName = ViewBag.DishName?.ToString() ?? "Unknown dish";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Dish Images</h2>
            <p class="text-muted mb-0">
                Dish: <strong>@dishName</strong>
                (ID: @dishId)
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="DishImage"
               asp-action="Create"
               asp-route-dishId="@dishId"
               class="btn btn-success">
                + Add Image
            </a>

            <a asp-controller="Dish"
               asp-action="Index"
               class="btn btn-secondary">
                Back to Dishes
            </a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var image in Model)
            {
                <div class="col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm">
                        <img src="@image.ImageUrl"
                             alt="Dish image"
                             class="card-img-top"
                             style="height:200px; object-fit:cover;"
                             onerror="this.onerror=null;this.src='https://placehold.co/400x250?text=Image+not+available';" />

                        <div class="card-body">
                            @if (image.IsThumbnail)
                            {
                                <span class="badge bg-success mb-2">
                                    Thumbnail / Ảnh đại diện
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary mb-2">
                                    Regular Image / Ảnh thường
                                </span>
                            }

                            <p class="small text-break">
                                @image.ImageUrl
                            </p>

                            @if (!image.IsThumbnail)
                            {
                                <form asp-action="SetThumbnail"
                                      asp-route-id="@image.Id"
                                      method="post"
                                      class="mb-2">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-primary btn-sm w-100">
                                        Set as Thumbnail
                                    </button>
                                </form>
                            }

                            <form asp-action="Delete"
                                  asp-route-id="@image.Id"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this image?');">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-danger btn-sm w-100">
                                    Delete Image
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            This dish has no images yet. Select Add Image to add the first image.
        </div>
    }
</div>
